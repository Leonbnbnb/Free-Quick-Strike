{
  "name": "furui-kuai-da",
  "version": "1.0.0",
  "description": "福瑞快打",
  "author": "福瑞快打",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.furui.kuaida",
    "productName": "福瑞快打",
    "files": [
      "index.html",
      "style.css",
      "themes.css",
      "js/**/*",
      "icon.svg",
      "assets/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
